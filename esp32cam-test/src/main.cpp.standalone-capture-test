/*
  ESP32-CAM standalone camera capture test
  Board: AI-Thinker ESP32-CAM with OV2640

  Purpose:
    - Test camera capture independently of Wi-Fi, web server, and servo code.
    - Report camera initialization and repeated frame capture results.

  Important:
    - Disconnect external peripherals from the ESP32-CAM during this test.
    - Use a stable 5V supply capable of powering the ESP32-CAM.
    - Do not connect a servo to GPIO 13 during this test.
*/

#include <Arduino.h>
#include "esp_camera.h"
#include "esp_heap_caps.h"

// AI-Thinker ESP32-CAM camera pin mapping
#define PWDN_GPIO_NUM     32
#define RESET_GPIO_NUM    -1
#define XCLK_GPIO_NUM      0
#define SIOD_GPIO_NUM     26
#define SIOC_GPIO_NUM     27
#define Y9_GPIO_NUM       35
#define Y8_GPIO_NUM       34
#define Y7_GPIO_NUM       39
#define Y6_GPIO_NUM       36
#define Y5_GPIO_NUM       21
#define Y4_GPIO_NUM       19
#define Y3_GPIO_NUM       18
#define Y2_GPIO_NUM        5
#define VSYNC_GPIO_NUM    25
#define HREF_GPIO_NUM     23
#define PCLK_GPIO_NUM     22

static bool initTestCamera() {
  Serial.println();
  Serial.println("========== CAMERA TEST: INITIALIZATION ==========");
  Serial.printf("Free heap before init: %u bytes\n", (unsigned int)ESP.getFreeHeap());
  Serial.printf("PSRAM found: %s\n", psramFound() ? "YES" : "NO");
  if (psramFound()) {
    Serial.printf("PSRAM total: %u bytes\n", (unsigned int)ESP.getPsramSize());
    Serial.printf("PSRAM free before init: %u bytes\n", (unsigned int)ESP.getFreePsram());
  }

  camera_config_t config = {};
  config.ledc_channel = LEDC_CHANNEL_0;
  config.ledc_timer = LEDC_TIMER_0;
  config.pin_d0 = Y2_GPIO_NUM;
  config.pin_d1 = Y3_GPIO_NUM;
  config.pin_d2 = Y4_GPIO_NUM;
  config.pin_d3 = Y5_GPIO_NUM;
  config.pin_d4 = Y6_GPIO_NUM;
  config.pin_d5 = Y7_GPIO_NUM;
  config.pin_d6 = Y8_GPIO_NUM;
  config.pin_d7 = Y9_GPIO_NUM;
  config.pin_xclk = XCLK_GPIO_NUM;
  config.pin_pclk = PCLK_GPIO_NUM;
  config.pin_vsync = VSYNC_GPIO_NUM;
  config.pin_href = HREF_GPIO_NUM;
  config.pin_sccb_sda = SIOD_GPIO_NUM;
  config.pin_sccb_scl = SIOC_GPIO_NUM;
  config.pin_pwdn = PWDN_GPIO_NUM;
  config.pin_reset = RESET_GPIO_NUM;

  // Start with a conservative, low-bandwidth capture mode.
  config.xclk_freq_hz = 20000000;
  config.pixel_format = PIXFORMAT_JPEG;
  config.frame_size = FRAMESIZE_QVGA;  // 320 x 240
  config.jpeg_quality = 12;
  config.fb_count = 2;
  config.grab_mode = CAMERA_GRAB_LATEST;

  if (psramFound()) {
    config.fb_location = CAMERA_FB_IN_PSRAM;
  } else {
    // JPEG capture at QVGA can sometimes work without PSRAM, but PSRAM is
    // expected on a typical AI-Thinker ESP32-CAM module.
    config.fb_location = CAMERA_FB_IN_DRAM;
    config.fb_count = 1;
  }

  Serial.println("Calling esp_camera_init()...");
  esp_err_t err = esp_camera_init(&config);
  if (err != ESP_OK) {
    Serial.printf("FAIL: esp_camera_init returned 0x%x\n", (unsigned int)err);
    Serial.printf("Free heap after failed init: %u bytes\n", (unsigned int)ESP.getFreeHeap());
    return false;
  }

  Serial.println("PASS: esp_camera_init returned ESP_OK");
  sensor_t *sensor = esp_camera_sensor_get();
  if (sensor == nullptr) {
    Serial.println("FAIL: esp_camera_sensor_get() returned NULL");
    return false;
  }

  Serial.printf("Sensor PID: 0x%04X\n", sensor->id.PID);
  Serial.printf("Sensor version: 0x%02X\n", sensor->id.VER);
  Serial.printf("Sensor frame-size status: %d\n", sensor->status.framesize);
  Serial.printf("Free heap after init: %u bytes\n", (unsigned int)ESP.getFreeHeap());
  if (psramFound()) {
    Serial.printf("Free PSRAM after init: %u bytes\n", (unsigned int)ESP.getFreePsram());
  }

  // Explicitly apply conservative capture settings after initialization.
  sensor->set_framesize(sensor, FRAMESIZE_QVGA);
  sensor->set_quality(sensor, 12);
  delay(500);
  Serial.println("========== INITIALIZATION COMPLETE ==========");
  return true;
}

static void runCaptureTest() {
  Serial.println();
  Serial.println("========== CAMERA FRAME CAPTURE TEST ==========");
  Serial.println("No Wi-Fi, HTTP server, or servo is running.");
  Serial.println("Testing 10 frame captures, one second apart.");

  unsigned int successCount = 0;
  unsigned int failureCount = 0;

  for (int attempt = 1; attempt <= 10; ++attempt) {
    Serial.printf("\nCapture %d/10: ", attempt);
    camera_fb_t *fb = esp_camera_fb_get();

    if (fb == nullptr) {
      ++failureCount;
      Serial.println("FAIL - camera_fb_get() returned NULL");
    } else {
      ++successCount;
      Serial.printf("PASS - %u x %u, %u bytes, format=%d\n",
                    (unsigned int)fb->width,
                    (unsigned int)fb->height,
                    (unsigned int)fb->len,
                    (int)fb->format);
      if (fb->len > 0 && fb->format == PIXFORMAT_JPEG) {
        const uint8_t *p = fb->buf;
        Serial.printf("JPEG signature: %02X %02X ... %02X %02X\n",
                      p[0], p[1], p[fb->len - 2], p[fb->len - 1]);
      }
      esp_camera_fb_return(fb);
    }

    Serial.printf("Free heap: %u bytes", (unsigned int)ESP.getFreeHeap());
    if (psramFound()) {
      Serial.printf(" | free PSRAM: %u bytes", (unsigned int)ESP.getFreePsram());
    }
    Serial.println();
    delay(1000);
  }

  Serial.println();
  Serial.println("========== TEST SUMMARY ==========");
  Serial.printf("Successful captures: %u/10\n", successCount);
  Serial.printf("Failed captures:     %u/10\n", failureCount);
  if (successCount == 10) {
    Serial.println("RESULT: PASS - camera is producing frames reliably.");
  } else if (successCount > 0) {
    Serial.println("RESULT: PARTIAL - camera produces some frames but is not reliable.");
  } else {
    Serial.println("RESULT: FAIL - no frames captured. Investigate camera hardware, ribbon, power, or driver/configuration.");
  }
  Serial.println("Test will repeat in 10 seconds. Copy this serial output for diagnosis.");
  Serial.println("==================================");
}

void setup() {
  Serial.begin(115200);
  delay(1200);
  Serial.println();
  Serial.println("===============================================");
  Serial.println("AI-THINKER ESP32-CAM - STANDALONE CAMERA TEST");
  Serial.println("No Wi-Fi / no web server / no servo");
  Serial.println("===============================================");

  if (!initTestCamera()) {
    Serial.println("Camera initialization failed. Halting; power-cycle after checking hardware.");
    while (true) {
      delay(1000);
    }
  }
}

void loop() {
  runCaptureTest();
  delay(10000);
}
